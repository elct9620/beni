/.bundle/
/vendor/

# Consumer-scenario harnesses vendor into their own directory so each
# run stays isolated from the repo's dogfooding vendor tree; their
# build configs are scenario:setup output, regenerated every run.
/test/scenarios/*/vendor/
/test/scenarios/*/build_config/
# The consumer crate resolves against the working tree through a path
# dependency, so its lock file records nothing the repo's own does not.
/test/scenarios/*/Cargo.lock

# Native build artifacts (any nesting level, matching kobako's rules):
# cargo target dirs, C objects, static libs (libmruby.a), and Ruby
# native-extension outputs with their mkmf build log.
target/
*.o
*.a
*.so
*.bundle
mkmf.log

# rbs collection install destination, regenerable from the committed
# lockfile (kobako convention).
/.gem_rbs_collection/
/.yardoc
/_yardoc/
/coverage/
/doc/
/pkg/
/spec/reports/
/tmp/

# The documentation bindings are generated where they are read — a local
# build writes its own before the documentation leg reads it, and the
# copy a published package carries is written by the release. Tracking
# one would pin a single host's output and need a gate to keep it
# current; `include` in beni-sys's manifest is what puts it in the
# package without git seeing it.
/crates/beni-sys/src/bindings_docs.rs
