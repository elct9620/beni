module Beni
  module Vendor
    type built_in_pair = { version: String, sha256: String | Hash[String, String] }

    BUILT_IN_PAIRS: Hash[String, built_in_pair]
    DEPENDENCIES: Hash[String, Array[String]]
    ARCH_ALIASES: Hash[String, String]
    OS_ALIASES: Hash[Regexp, String]
    BUILD_PLATFORM: String
    TOOLCHAIN_FACTORIES: Hash[String, Symbol]
    STAGED_DIRS: Hash[String, String]
    SELECTED_BY_DEFINITION: Array[String]

    def self.build_platform: (?String platform) -> String

    def self.platform_arch: (String platform) -> String

    def self.platform_os: (String platform) -> String

    def self?.wasi_sdk: (vendor_dir: String, ?version: String?, ?sha256: (String | UnvendoredChecksum)?) -> Toolchain

    def self?.mruby: (vendor_dir: String, ?version: String?, ?sha256: (String | UnvendoredChecksum)?) -> Toolchain

    def self?.prism: (vendor_dir: String, version: String, sha256: String) -> Toolchain

    def self?.base_url_for: (String default) -> String

    def self?.staged_dir: (String name) -> String

    def self?.built_in_sha256: (String name, String version, ?String platform) -> (String | UnvendoredChecksum)?

    def self?.stage_wasi_toolchain_file: (vendor_dir: String) -> String
  end
end
