module Beni
  module Vendor
    class Tarball
      VERSION_MARKER: String

      def self.staged_version: (String dir) -> String?

      @tarball: String
      @top_level_dir: String
      @final_dir: String
      @version: String

      def initialize: (tarball: String, top_level_dir: String, final_dir: String, version: String) -> void

      def prepare: () -> void

      private

      def installed_version: () -> String?

      def extract_to_staging: (String staging) -> void

      def run_tar: (String tarball, String staging) -> void

      def promote: (String staging) -> void
    end
  end
end
