# frozen_string_literal: true

# Consumer scenario: an embedded target that never compiles Ruby.
#
# The rust_consumer harness proves a crate outside the workspace can
# link the staged archive and run Ruby source through it. This one
# proves the other posture the crates offer: a build config that leaves
# mruby's compiler gem out, and a consumer crate that turns beni's
# default features off to match. Nothing here compiles Ruby at run
# time — the Ruby surface is defined from Rust and dispatched from
# Rust — so the archive carries no compiler and the crate offers no
# API that would need one. Run from this directory:
#
#   $ cd test/scenarios/embedded_no_compiler && rake scenario:setup beni:build scenario:verify
$LOAD_PATH.unshift File.expand_path("../../../lib", __dir__)

require "beni/tasks"

CONFIG = File.expand_path("build_config/mruby.rb", __dir__)

Beni::Tasks.new do
  build_config CONFIG

  target :host
end

namespace :scenario do
  # Part of the harness contract every scenario implements
  # (setup → beni:build → verify); the compiler-less build config is
  # the lesson here, so it is committed rather than generated.
  desc "No-op: the build config this scenario builds from is committed"
  task :setup

  desc "Build and run the consumer crate against the compiler-less archive"
  task :verify do
    abort "[scenario] cargo not on PATH" if system("cargo", "--version", %i[out err] => File::NULL).nil?

    sh({ "BENI_VENDOR_DIR" => File.expand_path("vendor", __dir__) },
       "cargo", "test", "--manifest-path", File.expand_path("Cargo.toml", __dir__))

    puts "[scenario] embedded_no_compiler linked and ran with no compiler in the archive"
  end
end
