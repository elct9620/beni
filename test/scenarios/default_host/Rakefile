# frozen_string_literal: true

# Consumer scenario: the gem's zero-configuration path.
#
# A consumer adds `Beni::Tasks.new` to its Rakefile with no settings:
# mruby alone is vendored, the build runs mruby's untouched upstream
# build_config/default.rb, and the single `host` target is produced.
# Run from this directory so the default vendor_dir resolves here,
# exactly as it would in a consumer's project root:
#
#   $ cd test/scenarios/default_host && rake scenario:setup beni:build scenario:verify
#
# Unlike the repo-root Rakefile (custom config, host + wasi cross
# build), this exercises the path a consumer hits first — including
# the real tarball download when the vendor tree is absent.
$LOAD_PATH.unshift File.expand_path("../../../lib", __dir__)

require "beni/tasks"

TASKS = Beni::Tasks.new

# Wired from the same resolved declarations the task surface was,
# so the check cannot drift from what `beni:build` actually stages.
BUILDER = Beni::Builder.new(vendor_dir: TASKS.configuration.vendor_dir,
                            targets: TASKS.configuration.targets)

# What `beni:build` must leave behind for one target. The gem's own
# builder answers it: the archive's file name follows the toolchain
# that built it, and the sidecar beside it is what names that file.
def staged_artifacts(target)
  [BUILDER.flags_mak_path(target), BUILDER.archive_path(target)].compact
end

namespace :scenario do
  # Part of the harness contract every scenario implements
  # (setup → beni:build → verify); the zero-configuration path has
  # nothing to prepare.
  desc "No-op: the zero-configuration path needs no preparation"
  task :setup

  desc "Assert the artifacts beni:build must leave behind"
  task :verify do
    artifacts = staged_artifacts("host")

    missing = artifacts.reject { |path| File.exist?(path) }
    abort "[scenario] missing artifacts:\n  #{missing.join("\n  ")}" unless missing.empty?

    puts "[scenario] default_host artifacts verified: #{artifacts.join(", ")}"
  end
end
